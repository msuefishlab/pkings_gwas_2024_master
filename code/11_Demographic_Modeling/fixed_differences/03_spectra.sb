#!/bin/bash --login
#SBATCH --time=02:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=8G
#SBATCH --job-name=fd_spectra
#SBATCH -o output_data/slurm_logs/11_Demographic_Modeling/spectra_%x_%A_%a.log
## 03_spectra.sb: run 03_spectra.py on one site-table chunk. MODE is an_hist, bins or spectra, in that
## order, with 04_projections.py after an_hist and 05_deserts.py after bins (DESIGN.md sections 3-4).
##   sbatch --export=root=$(pwd),MODE=an_hist --array=0-102%60 code/11_Demographic_Modeling/fixed_differences/03_spectra.sb
## Optional: ROLES (pair roles, default headline_whole,tp_control_whole) and SUFFIX for sensitivity sets.
set -euo pipefail
cd "${root}"
source "${root}/pkings_gwas.env"
export OMP_NUM_THREADS=1
args=(--mode "${MODE}" --chunk_id "${SLURM_ARRAY_TASK_ID}")
[[ -n "${ROLES:-}" ]] && args+=(--pairs_role "${ROLES}")
[[ -n "${SUFFIX:-}" ]] && args+=(--suffix "${SUFFIX}")
singularity exec --bind /mnt/gs21 "${dadi_image}" \
  python3 code/11_Demographic_Modeling/fixed_differences/03_spectra.py "${args[@]}"
echo "done ${MODE} chunk ${SLURM_ARRAY_TASK_ID}"
