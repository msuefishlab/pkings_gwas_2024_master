#!/bin/bash --login
#SBATCH --time=03:59:00
#SBATCH --cpus-per-task=1
#SBATCH --mem=12G
#SBATCH --job-name=fd_diag
#SBATCH -o output_data/slurm_logs/11_Demographic_Modeling/timestep_%A_%a.log
set -euo pipefail
cd "${root}"; source pkings_gwas.env; export OMP_NUM_THREADS=1
jobs=(x "A2w M0" "A4w M0" "A3w M0" "A2w M3" "A1w M3" "A2w M3f")
singularity exec --bind /mnt/gs21 "${dadi_image}" python3 code/11_Demographic_Modeling/fixed_differences/diagnostics/timestep.py ${jobs[${SLURM_ARRAY_TASK_ID}]}
