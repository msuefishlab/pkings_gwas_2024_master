#!/bin/bash --login
#SBATCH --time=03:59:00
#SBATCH --cpus-per-task=1
#SBATCH --mem=12G
#SBATCH --job-name=fd_diag
#SBATCH -o output_data/slurm_logs/11_Demographic_Modeling/numerics_%A_%a.log
set -euo pipefail
cd "${root}"; source pkings_gwas.env; export OMP_NUM_THREADS=1
pairs=(x A1w A2w A3w A4w C1w C2w)
singularity exec --bind /mnt/gs21 "${dadi_image}" python3 code/11_Demographic_Modeling/fixed_differences/diagnostics/numerics.py ${pairs[${SLURM_ARRAY_TASK_ID}]} M0,M3,M0f,M3f
